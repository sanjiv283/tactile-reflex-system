static const seg_t s05[]  = { PRE(400), SEG(6,400,400,1,0,0,0,0,1,1,-1,4,0), SEG(6,400,400,1,0,1,0,0,-1,1,-1,4,0), CLR(400), RUN(6,400,400,-1,0,-1,-1,1) };
